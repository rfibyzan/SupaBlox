<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SupaBlox.ViewModels"
        x:Class="SupaBlox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/supablox.ico"
        Width="1440" Height="900" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="240,*">

    <!-- ================= SIDEBAR ================= -->
    <Border Grid.Column="0" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,20,12,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="10,0,0,26">
          <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentGrad}">
            <TextBlock Text="S" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SupaBlox" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="ACCOUNT MANAGER" Classes="dim" FontSize="9" LetterSpacing="1" />
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="card" Padding="14,12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Multi Roblox" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding MultiEnabled}" OnContent="" OffContent="" MinWidth="0" Margin="0,-6,-10,-6" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" IsVisible="{Binding MutexOk}" VerticalAlignment="Center" />
              <Ellipse Width="7" Height="7" Fill="{StaticResource DimBrush}" IsVisible="{Binding !MutexOk}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding MultiShort}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="180" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel>
          <TextBlock Text="WORKSPACE" Classes="section" Margin="12,0,0,8" />
          <ListBox Classes="nav" SelectedIndex="{Binding PageIndex, Mode=TwoWay}">
            <ListBoxItem>
              <Grid ColumnDefinitions="26,*,Auto">
                <TextBlock Text="☺" Classes="navicon" Foreground="{StaticResource MutedBrush}" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Akun" Classes="navtext" FontSize="13" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="{StaticResource Card2Brush}" CornerRadius="9" Padding="8,1">
                  <TextBlock Text="{Binding AccountCount}" Classes="muted" FontSize="10" FontWeight="Bold" />
                </Border>
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="26,*">
                <TextBlock Text="◈" Classes="navicon" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Game &amp; server" Classes="navtext" FontSize="13" VerticalAlignment="Center" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid ColumnDefinitions="26,*,Auto">
                <TextBlock Text="▭" Classes="navicon" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Instance" Classes="navtext" FontSize="13" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="{StaticResource Card2Brush}" CornerRadius="9" Padding="8,1">
                  <TextBlock Text="{Binding InstanceCountText}" Classes="muted" FontSize="10" FontWeight="Bold" />
                </Border>
              </Grid>
            </ListBoxItem>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= KONTEN ================= -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">

      <!-- ========== HALAMAN AKUN ========== -->
      <Grid IsVisible="{Binding IsAccountsPage}" Margin="32,26,24,18" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,340">
        <StackPanel Grid.ColumnSpan="2">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Akun &amp; Kontrol Cepat" Classes="h1" />
              <TextBlock Text="{Binding AccountsSubtitle}" Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="primary" Content="+  Tambah akun" Command="{Binding OpenAddCommand}" />
              <Button Content="⇪  Impor massal" Command="{Binding OpenBulkCommand}" />
              <Button Content="⟳  Refresh status" Command="{Binding RefreshStatusCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0" ColumnDefinitions="260,12,170,12,170,*">
          <TextBox Text="{Binding AccountFilter}" Watermark="Cari akun / catatan" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusFilter}" HorizontalAlignment="Stretch" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding GroupFilter}" HorizontalAlignment="Stretch" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,12" ColumnDefinitions="Auto,Auto,*,Auto">
          <Ellipse Width="8" Height="8" Fill="#7C5CFF" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding VisibleHeader}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding SelectedBadge, StringFormat='  •  {0} dipilih'}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" VerticalAlignment="Center" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
            <Button Classes="chip" Content="Pilih semua" Command="{Binding SelectAllCommand}" />
            <Button Classes="chip" Content="Batal pilih" Command="{Binding ClearSelectionCommand}" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
          <Panel>
            <Border Classes="card" IsVisible="{Binding NoAccounts}" Padding="28" Margin="0,0,16,0">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Belum ada akun" Classes="h2" HorizontalAlignment="Center" />
                <TextBlock Text="Klik Tambah akun untuk login lewat browser atau tempel cookie." Classes="muted" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding VisibleAccounts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountItem">
                  <Border Classes="card" Classes.selected="{Binding IsSelected}" Width="246" Margin="0,0,14,14">
                    <StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{Binding AvatarBrush}" ClipToBounds="True">
                          <Panel>
                            <TextBlock Text="{Binding Initial}" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,2,4,0">
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding UserText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,-6,-8,0" MinWidth="0" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,14,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                      </StackPanel>
                      <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
                        <TextBlock Text="Grup" Classes="dim" />
                        <TextBlock Grid.Column="1" Text="{Binding GroupText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="Game default" Classes="dim" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DefaultGameText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
                        <Button Classes="primary" Content="▶  Launch" Command="{Binding LaunchCommand}" IsVisible="{Binding !ShowPill}" HorizontalAlignment="Stretch" Height="36" />
                        <Border IsVisible="{Binding ShowPill}" Height="36" CornerRadius="8" Background="#14302C" BorderBrush="#1E5A4A" BorderThickness="1">
                          <TextBlock Text="{Binding RunningText}" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Command="{Binding FavoriteCommand}">
                          <TextBlock Text="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" FontSize="15" />
                        </Button>
                        <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0" Content="⋯" Command="{Binding EditCommand}" ToolTip.Tip="Edit akun" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </ScrollViewer>

        <!-- ===== Kontrol Cepat ===== -->
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Classes="card" Margin="4,22,0,0" Padding="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="7" Margin="20,8,20,14">
              <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Isian tersimpan otomatis, tetap ada saat pindah tab" Classes="dim" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="20,18,20,8" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="⚡ Kontrol Cepat" Classes="title" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="badge">
                    <TextBlock Text="{Binding SelectedBadge}" Foreground="{StaticResource AccentTextBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                  <TextBlock Text="Game" Classes="label" />
                  <TextBlock Grid.Column="1" Text="nama game atau Place ID" Classes="dim" VerticalAlignment="Center" />
                </Grid>
                <Panel>
                  <TextBox x:Name="PickerBox" Text="{Binding PickerQuery}" Watermark="Cari nama game…" IsVisible="{Binding NoQuickGame}" />
                  <Border IsVisible="{Binding HasQuickGame}" Background="{StaticResource Card2Brush}" BorderBrush="#463C8C" BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="38" Height="38" CornerRadius="8" Background="{Binding QuickGame.AvatarBrush}" ClipToBounds="True">
                        <Panel>
                          <TextBlock Text="{Binding QuickGame.Initial}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding QuickGame.Icon}" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QuickGame.Name}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding QuickGame.PlaceIdText}" Classes="muted mono" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="icon" Width="28" Height="28" FontSize="11" Content="✕" Command="{Binding ClearQuickGameCommand}" ToolTip.Tip="Ganti game" />
                    </Grid>
                  </Border>
                  <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding #PickerBox}" Placement="BottomEdgeAlignedRight"
                         IsLightDismissEnabled="True" Width="380" VerticalOffset="6">
                    <Border Background="#181E32" BorderBrush="#463C8C" BorderThickness="1" CornerRadius="12" Padding="6" BoxShadow="0 10 30 0 #A0000000">
                      <StackPanel>
                        <TextBlock Text="{Binding PickerInfo}" IsVisible="{Binding HasPickerInfo}" Classes="muted" Margin="12,10" />
                        <ItemsControl ItemsSource="{Binding PickerResults}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameItem">
                              <Button Classes="row" Command="{Binding SelectCommand}" CornerRadius="8" Margin="0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8">
                                  <Border Width="36" Height="36" CornerRadius="8" Background="{Binding AvatarBrush}" ClipToBounds="True">
                                    <Panel>
                                      <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Panel>
                                  </Border>
                                  <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PlaceIdText}" Classes="muted mono" FontSize="10" Margin="0,2,0,0" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" />
                                    <TextBlock Text="{Binding PlayingText}" Classes="muted" FontSize="10" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="12,8">
                          <TextBlock Text="Enter = pakai teratas  •  Esc = tutup  •  tempel Place ID / link juga bisa" Classes="dim" FontSize="10" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </Popup>
                </Panel>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasRecent}">
                  <TextBlock Text="Terakhir" Classes="dim" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <ItemsControl ItemsSource="{Binding RecentGames}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GameItem">
                        <Button Classes="chip" Content="{Binding ShortName}" Command="{Binding SelectCommand}" Margin="0,0,6,4" ToolTip.Tip="{Binding Name}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="Job ID / link server privat (opsional)" Classes="label" Margin="0,12,0,4" />
                <TextBox Text="{Binding QuickJobId}" Watermark="kosong = server acak" />

                <Button Classes="primary" Content="▶  Launch akun terpilih" Command="{Binding LaunchSelectedCommand}" HorizontalAlignment="Stretch" Height="42" FontSize="14" Margin="0,14,0,0" />

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,6" />
                <Grid ColumnDefinitions="*,12,*">
                  <StackPanel>
                    <TextBlock Text="Jeda antar launch (dtk)" Classes="label" />
                    <NumericUpDown Value="{Binding LaunchDelay}" Minimum="0" Maximum="120" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Maks instance" Classes="label" />
                    <NumericUpDown Value="{Binding MaxInstances}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                  </StackPanel>
                </Grid>
                <CheckBox Content="Pakai game default akun jika Game kosong" IsChecked="{Binding UseDefaultGame}" Margin="0,10,0,0" />
                <CheckBox Content="Sembunyikan username" IsChecked="{Binding HideUsernames}" />

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,6" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Antrean launch" Classes="label" />
                  <Button Grid.Column="1" Classes="chip" Content="Kosongkan" Command="{Binding ClearQueueCommand}" IsVisible="{Binding !QueueEmpty}" />
                </Grid>
                <TextBlock Text="Kosong" Classes="dim" IsVisible="{Binding QueueEmpty}" Margin="0,2,0,0" />
                <ItemsControl ItemsSource="{Binding Queue}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueItem">
                      <Border Classes="card2" Padding="10,8" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="28" Height="28" CornerRadius="14" Background="{Binding AvatarBrush}">
                            <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="10" Margin="0,1,0,0" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="icon" Width="26" Height="26" FontSize="10" Content="✕" Command="{Binding CancelCommand}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ========== HALAMAN GAME & SERVER ========== -->
      <Grid IsVisible="{Binding IsGamesPage}" Margin="32,26,24,18" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="5*,20,6*">
        <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Cari game, pilih servernya." Classes="h1" />
            <TextBlock Text="Server publik diurutkan dari ping terendah. Join memakai akun yang dicentang di tab Akun." Classes="muted" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
        <TextBox Grid.Row="1" Margin="0,22,0,0" Text="{Binding GameQuery}" Watermark="Cari nama game, Place ID, atau link roblox.com/games/…" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,20,0,10">
          <TextBlock Text="{Binding GameListTitle}" FontWeight="Bold" FontSize="13" />
          <TextBlock Grid.Column="1" Text="{Binding GameListInfo}" Classes="muted" FontSize="11" />
        </Grid>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding GameResults}" Margin="0,0,10,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItem">
                <Border Classes="card" Classes.selected="{Binding IsCurrent}" Padding="0" Margin="0,0,0,10">
                  <Button Classes="row" Command="{Binding SelectCommand}" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,12">
                      <Border Width="60" Height="60" CornerRadius="10" Background="{Binding AvatarBrush}" ClipToBounds="True">
                        <Panel>
                          <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,2,8,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CreatorText}" Classes="muted" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" />
                          <TextBlock Text="{Binding PlayingText}" Classes="muted" FontSize="10" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" Classes="card" Margin="0,22,0,0" Padding="0">
          <Panel>
            <StackPanel IsVisible="{Binding NoSelectedGame}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
              <TextBlock Text="◈" FontSize="34" Foreground="#A06CFF" HorizontalAlignment="Center" />
              <TextBlock Text="Pilih game di kiri" Classes="h2" HorizontalAlignment="Center" />
              <TextBlock Text="Daftar server publiknya akan muncul di sini." Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
            <DockPanel IsVisible="{Binding HasSelectedGame}">
              <StackPanel DockPanel.Dock="Top" Margin="24,20,24,0">
                <TextBlock Text="GAME" Foreground="#A06CFF" FontSize="10" FontWeight="Bold" LetterSpacing="1" />
                <TextBlock Text="{Binding SelectedGame.Name}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding SelectedGame.CreatorText}" Classes="muted" Margin="0,4,0,0" />
                <Grid ColumnDefinitions="Auto,40,Auto,*,Auto" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="PLACE ID" Classes="section" FontSize="9" />
                    <TextBlock Text="{Binding SelectedGame.PlaceIdText}" Classes="mono" FontSize="13" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="BERMAIN" Classes="section" FontSize="9" />
                    <TextBlock Text="{Binding SelectedGame.PlayingText}" FontSize="13" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="Salin ID" Command="{Binding CopyPlaceIdCommand}" FontSize="12" />
                    <Button Content="Pakai di Kontrol Cepat" Command="{Binding UseInQuickCommand}" FontSize="12" />
                    <Button Classes="icon" Command="{Binding ToggleFavoriteGameCommand}" ToolTip.Tip="Favorit">
                      <TextBlock Text="{Binding SelectedGame.FavoriteGlyph}" Foreground="{Binding SelectedGame.FavoriteBrush}" FontSize="15" />
                    </Button>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="-24,18,-24,14" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="Join sebagai" Classes="muted" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="12,0">
                    <TextBlock Text="{Binding SelectedNames}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </Border>
                  <Button Grid.Column="2" Classes="primary" Content="▶  Join server acak" Command="{Binding JoinRandomCommand}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,8">
                  <TextBlock Text="Server publik" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ServerInfo}" Classes="muted" FontSize="11" Margin="12,0" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="⟳  Refresh server" Command="{Binding RefreshServersCommand}" FontSize="12" />
                </Grid>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,16,16">
                  <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ServerItem">
                        <Border Classes="card2" Padding="16,10" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,110,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="{Binding PingBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PingText}" FontWeight="Bold" FontSize="12" />
                              </StackPanel>
                              <TextBlock Text="{Binding JobId}" Classes="muted mono" FontSize="10" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="0,0,16,0">
                              <TextBlock Text="{Binding PlayersText}" FontSize="11" />
                              <ProgressBar Classes="slot" Value="{Binding Fill}" Minimum="0" Maximum="100" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="primary" Content="Join" Command="{Binding JoinCommand}" MinWidth="72" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Muat lebih banyak" Command="{Binding LoadMoreServersCommand}" IsVisible="{Binding HasMoreServers}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>
        </Border>
      </Grid>

      <!-- ========== HALAMAN INSTANCE ========== -->
      <ScrollViewer IsVisible="{Binding IsInstancesPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,24,18" Spacing="18">
          <StackPanel>
            <TextBlock Text="Instance" Classes="h1" />
            <TextBlock Text="Multi Roblox dan proses RobloxPlayerBeta yang berjalan" Classes="muted" Margin="0,4,0,0" />
          </StackPanel>
          <Grid ColumnDefinitions="2*,16,*,16,*,16,*">
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Multi Roblox" Classes="h2" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding MultiEnabled}" OnContent="" OffContent="" MinWidth="0" Margin="0,-6,-10,-6" />
                </Grid>
                <Border Classes="badge" HorizontalAlignment="Left" Background="{Binding MultiBadgeBg}">
                  <TextBlock Text="{Binding MultiBadge}" Foreground="{Binding MultiBadgeFg}" FontSize="10" FontWeight="Bold" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" IsVisible="{Binding MutexOk}" VerticalAlignment="Center" />
                  <Ellipse Width="7" Height="7" Fill="{StaticResource DimBrush}" IsVisible="{Binding !MutexOk}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding MutexText}" Classes="mono" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" IsVisible="{Binding EventOk}" VerticalAlignment="Center" />
                  <Ellipse Width="7" Height="7" Fill="{StaticResource DimBrush}" IsVisible="{Binding !EventOk}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding EventText}" Classes="mono" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="Roblox berjalan" Classes="muted" />
                <TextBlock Text="{Binding InstanceCountText}" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="instance" Classes="dim" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="Durasi aktif" Classes="muted" />
                <TextBlock Text="{Binding UptimeText}" FontSize="26" FontWeight="Bold" Classes="mono" />
                <TextBlock Text="{Binding UptimeSub}" Classes="dim" />
              </StackPanel>
            </Border>
            <Border Grid.Column="6" Classes="card" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="Mode" Classes="muted" />
                <TextBlock Text="Mutex-only" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="tanpa sentuh memori Roblox" Classes="dim" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card" Padding="0">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,16,20,14">
                <TextBlock Text="Instance berjalan" Classes="h2" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Content="+  Buka Roblox baru" Command="{Binding OpenRobloxNewCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="⟳  Refresh" Command="{Binding RefreshInstancesCommand}" />
              </Grid>
              <Border Background="{StaticResource Card2Brush}" Padding="20,9">
                <Grid ColumnDefinitions="90,180,110,110,*,300">
                  <TextBlock Text="PID" Classes="muted" FontWeight="Bold" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="Akun" Classes="muted" FontWeight="Bold" FontSize="11" />
                  <TextBlock Grid.Column="2" Text="Mulai" Classes="muted" FontWeight="Bold" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="RAM" Classes="muted" FontWeight="Bold" FontSize="11" />
                  <TextBlock Grid.Column="4" Text="Judul jendela" Classes="muted" FontWeight="Bold" FontSize="11" />
                </Grid>
              </Border>
              <TextBlock Text="Belum ada Roblox yang berjalan." Classes="muted" IsVisible="{Binding NoInstances}" Margin="20,18" />
              <ItemsControl ItemsSource="{Binding Instances}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InstanceItem">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                      <Grid ColumnDefinitions="90,180,110,110,*,300">
                        <TextBlock Text="{Binding Pid}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Border Width="24" Height="24" CornerRadius="12" Background="{Binding AvatarBrush}">
                            <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding AccountName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding StartText}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding RamText}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                          <Button Content="Fokus" Command="{Binding FocusCommand}" FontSize="12" MinWidth="100" />
                          <Button Content="Tutup (graceful)" Command="{Binding CloseCommand}" FontSize="12" MinWidth="170" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Tutup (graceful) mengirim WM_CLOSE ke jendela, sama seperti klik X. SupaBlox tidak membaca/menulis memori atau menyuntik apa pun ke Roblox."
                         Classes="dim" TextWrapping="Wrap" Margin="20,14,20,16" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="20">
            <StackPanel Spacing="14">
              <TextBlock Text="Opsi aplikasi" Classes="h2" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ToggleSwitch IsChecked="{Binding MinimizeToTray}" OnContent="" OffContent="" MinWidth="0" />
                  <TextBlock Text="Tutup jendela = minimize ke tray" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                  <ToggleSwitch IsChecked="{Binding StartWithWindows}" OnContent="" OffContent="" MinWidth="0" />
                  <TextBlock Text="Mulai bersama Windows (langsung ke tray)" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                  <ToggleSwitch IsChecked="{Binding MultiOnStart}" OnContent="" OffContent="" MinWidth="0" />
                  <TextBlock Text="Nyalakan Multi Roblox saat SupaBlox dibuka" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ========== STATUS BAR ========== -->
      <Border Grid.Row="1" IsVisible="{Binding HasMessage}" Margin="32,0,24,14" CornerRadius="10" Padding="16,10"
              Background="#1B2237" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
              Classes.err="{Binding MessageIsError}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" IsVisible="{Binding !MessageIsError}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Ellipse Width="8" Height="8" Fill="{StaticResource RedBrush}" IsVisible="{Binding MessageIsError}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="icon" Width="24" Height="24" FontSize="10" Content="✕" Command="{Binding DismissMessageCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= DIALOG TAMBAH AKUN ================= -->
    <Border Grid.ColumnSpan="2" IsVisible="{Binding IsAddOpen}" Background="#B0050710">
      <Border Width="520" Background="#141A2C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16"
              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 0 #C0000000">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="24,22,18,16">
            <StackPanel>
              <TextBlock Text="Tambah Akun" FontSize="19" FontWeight="Bold" />
              <TextBlock Text="Login lewat browser, tempel cookie, atau impor massal." Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon" Width="30" Height="30" FontSize="12" Content="✕" Command="{Binding CloseAddCommand}" VerticalAlignment="Top" />
          </Grid>
          <Border Height="1" Background="{StaticResource LineBrush}" />
          <StackPanel Margin="24,18,24,18" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="tab" Classes.on="{Binding IsAddTab0}" Content="Login browser" Command="{Binding AddTabCommand}" CommandParameter="0" />
              <Button Classes="tab" Classes.on="{Binding IsAddTab1}" Content="Tempel cookie" Command="{Binding AddTabCommand}" CommandParameter="1" />
              <Button Classes="tab" Classes.on="{Binding IsAddTab2}" Content="Impor massal" Command="{Binding AddTabCommand}" CommandParameter="2" />
            </StackPanel>

            <Border IsVisible="{Binding IsAddTab0}" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,14,0,4">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="◍" FontSize="30" Foreground="#A06CFF" HorizontalAlignment="Center" />
                <TextBlock Text="Jendela login Roblox (Edge, profil sementara) akan terbuka." FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="Setelah login, cookie disimpan terenkripsi (DPAPI) lalu profil dihapus." Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                  <Button Classes="primary" Content="Buka jendela login" Command="{Binding BrowserLoginCommand}" IsVisible="{Binding AddIdle}" />
                  <Button Content="Batalkan login" Command="{Binding CancelBrowserLoginCommand}" IsVisible="{Binding AddBusy}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding IsAddTab1}" Margin="0,14,0,4">
              <TextBlock Text="Cookie .ROBLOSECURITY" Classes="label" />
              <TextBox Text="{Binding AddCookie}" PasswordChar="•" Watermark="_|WARNING:-DO-NOT-SHARE-THIS…" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsAddTab2}" Margin="0,14,0,4">
              <TextBlock Text="Satu akun per baris: cookie, atau user:pass:cookie (bagian cookie yang dipakai)" Classes="label" TextWrapping="Wrap" />
              <TextBox Text="{Binding AddBulk}" AcceptsReturn="True" TextWrapping="NoWrap" Height="120" VerticalContentAlignment="Top" Watermark="_|WARNING:-DO-NOT-SHARE-THIS…&#10;User2:Pass2:_|WARNING:…" />
            </StackPanel>

            <Grid ColumnDefinitions="*,14,*" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Grup" Classes="label" />
                <TextBox Text="{Binding AddGroup}" Watermark="mis. Main / Alt farm" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Game default (Place ID)" Classes="label" />
                <TextBox Text="{Binding AddPlace}" Watermark="opsional" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Catatan" Classes="label" />
            <TextBox Text="{Binding AddNote}" Watermark="Catatan pribadi untuk akun ini" />
            <TextBlock Text="{Binding AddStatus}" IsVisible="{Binding HasAddStatus}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
          <Border Height="1" Background="{StaticResource LineBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="24,14">
            <Button Content="Batal" Command="{Binding CloseAddCommand}" MinWidth="96" />
            <Button Classes="primary" Content="{Binding AddSaveText, StringFormat='✓  {0}'}" Command="{Binding AddSaveCommand}" IsVisible="{Binding ShowAddSave}" IsEnabled="{Binding AddIdle}" MinWidth="150" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ================= DIALOG EDIT AKUN ================= -->
    <Border Grid.ColumnSpan="2" IsVisible="{Binding IsEditOpen}" Background="#B0050710">
      <Border Width="520" Background="#141A2C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16"
              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 0 #C0000000">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="24,22,18,16">
            <StackPanel>
              <TextBlock Text="Edit Akun" FontSize="19" FontWeight="Bold" />
              <TextBlock Text="{Binding Editing.UserText}" Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon" Width="30" Height="30" FontSize="12" Content="✕" Command="{Binding CloseEditCommand}" VerticalAlignment="Top" />
          </Grid>
          <Border Height="1" Background="{StaticResource LineBrush}" />
          <StackPanel Margin="24,12,24,18" Spacing="2">
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel>
                <TextBlock Text="Alias (opsional)" Classes="label" />
                <TextBox Text="{Binding EditAlias}" Watermark="nama tampilan di SupaBlox" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Grup" Classes="label" />
                <TextBox Text="{Binding EditGroup}" Watermark="mis. Main / Alt farm" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Game default (Place ID atau link)" Classes="label" />
            <TextBox Text="{Binding EditPlace}" Watermark="mis. 2753915549" />
            <TextBlock Text="Catatan" Classes="label" />
            <TextBox Text="{Binding EditNote}" Watermark="Catatan pribadi" />
            <TextBlock Text="Perbarui cookie (isi hanya jika kedaluwarsa)" Classes="label" />
            <TextBox Text="{Binding EditCookie}" PasswordChar="•" Watermark="_|WARNING:-DO-NOT-SHARE-THIS…" />
            <CheckBox Content="Favorit (tampil paling atas)" IsChecked="{Binding EditFavorite}" Margin="0,10,0,0" />
            <TextBlock Text="{Binding EditStatus}" IsVisible="{Binding HasEditStatus}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
          <Border Height="1" Background="{StaticResource LineBrush}" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="24,14">
            <Button Content="{Binding DeleteText}" Command="{Binding EditDeleteCommand}" Foreground="{StaticResource RedBrush}" />
            <Button Grid.Column="2" Content="Batal" Command="{Binding CloseEditCommand}" MinWidth="96" Margin="0,0,10,0" />
            <Button Grid.Column="3" Classes="primary" Content="✓  Simpan" Command="{Binding EditSaveCommand}" MinWidth="130" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
